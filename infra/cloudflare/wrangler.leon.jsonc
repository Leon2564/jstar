{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jstar-leon",
  "main": "src/leon.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../../apps/web/dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "jstar-media" }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "VIDU_SESSION_LIMITER", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } },
    { "name": "VIDU_GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "TEXT_AGENT_LIMITER", "namespace_id": "1003", "simple": { "limit": 12, "period": 60 } },
    { "name": "TEXT_AGENT_GLOBAL_LIMITER", "namespace_id": "1004", "simple": { "limit": 100, "period": 60 } },
    { "name": "TEXT_TRANSLATION_LIMITER", "namespace_id": "1005", "simple": { "limit": 12, "period": 60 } },
    { "name": "TEXT_TRANSLATION_GLOBAL_LIMITER", "namespace_id": "1006", "simple": { "limit": 100, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
