# Copy to .env. Every secret below MUST be replaced outside local development:
# the API refuses to start in production while any of them still has its development default.
NODE_ENV=development
API_PORT=8080
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_ADMIN_ORIGIN=http://localhost:5174
JWT_SECRET=dev-secret-change-me
SERIAL_HASH_PEPPER=dev-pepper
AGENT_BASE_URL=http://localhost:8100
AGENT_API_KEY=change-me
# Fixed OTP 123456, demo serial codes, demo admin (admin@jstar.demo), instant purchases. Never in production.
DEMO_MODE=false
# Only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Web Push (optional). Empty = push off and the web app never offers notifications.
# Make a pair with `npx web-push generate-vapid-keys`; never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@jstarcards.ai

# apps/agent
MODEL_BACKEND=stub
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_NAME=jstar-persona-12b

# Real streaming replies. Keep `stub` for an offline demo, use `openrouter` with a server-side key,
# or `openai-compatible` for a local vLLM/OpenAI-compatible endpoint.
OPENROUTER_API_KEY=
CHAT_MODEL=deepseek/deepseek-v4.1-flash@deepseek
CHAT_MODEL_FALLBACK=qwen/qwen3.7-plus

# Local preview voice. The browser never receives these values. Use only an authorized Fish Audio voice clone id.
# Production keeps these secrets in the Cloudflare Worker and sets TTS_URL on the API instead.
TTS_PROVIDER=fish
FISH_API_KEY=
TTS_VOICES={"eimi":"your-fish-reference-id"}

# Vidu S real-time avatar. Keep the token server-side. Provision the supplied image and voice once with:
# node tools/vidu/provision.mjs
VIDU_LIVE_BASE_URL=https://api.vidu.com
VIDU_API_TOKEN=
VIDU_EIMI_MANIFEST=assets/agency/eimi/vidu.json
VIDU_EIMI_AVATAR_ID=
VIDU_EIMI_VOICE=
VIDU_MAHIRO_MANIFEST=assets/agency/mahiro/vidu.json
VIDU_MAHIRO_AVATAR_ID=
VIDU_MAHIRO_VOICE=
VIDU_NANA_MANIFEST=assets/agency/nana/vidu.json
VIDU_NANA_AVATAR_ID=
VIDU_NANA_VOICE=
VIDU_UNPAI_MANIFEST=assets/agency/unpai/vidu.json
VIDU_UNPAI_AVATAR_ID=
VIDU_UNPAI_VOICE=
VIDU_ALICE_MANIFEST=assets/agency/alice/vidu.json
VIDU_ALICE_AVATAR_ID=
VIDU_ALICE_VOICE=
