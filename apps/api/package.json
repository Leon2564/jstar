{
  "name": "@jstar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "start": "node dist/server.mjs",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@jstar/shared": "*",
    "fastify": "^4.28.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
